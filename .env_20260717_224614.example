# 模型配置
# Provider 可选：openai_compatible / openai / azure_openai /
# anthropic / gemini / ollama
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-max
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_EXTRA_BODY=

# Azure OpenAI 专用
AZURE_OPENAI_API_VERSION=2024-10-21

# 结构化输出
STRUCTURED_OUTPUT_METHOD=function_calling

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/tasks.db

# 应用
APP_ENV=development
LOG_LEVEL=INFO
MAX_REFLOW_COUNT=2

# 记忆与流程能力
MEMORY_ENABLED=false
MEMORY_EMBEDDING_PROVIDER=auto
MEMORY_EMBEDDING_MODEL=text-embedding-v3
DIALOGUE_ENABLED=false
PLAN_VARIANTS_ENABLED=false
REPAIRER_ENABLED=true
SELF_REFINE_ENABLED=true
